# Copie para .env e preencha. NUNCA commite o .env.
TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3-flash-preview
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash
# Trave o bot pro seu user_id do Telegram (descubra mandando /start e olhando o log)
ALLOWED_USER_ID=

# Postgres do Supabase: Settings -> Database -> Connection string (URI, modo "Transaction")
DATABASE_URL=
