# Copie para .env e preencha. NUNCA commite o .env.

# === Telegram ===
TELEGRAM_BOT_TOKEN=

# Trava o bot pro seu user_id (vazio = qualquer um pode usar)
# Pra descobrir: deixa vazio, manda /start, olha o log
ALLOWED_USER_ID=

# === OpenRouter ===
OPENROUTER_API_KEY=

# Modelo de visão (analisa fotos: prato, cardápio, relógio, balança)
OPENROUTER_MODEL=google/gemini-3-flash-preview

# Modelo do agente conversacional (precisa suportar tool calling)
# Recomendado: google/gemma-4-31b-it  (estável, tool calling nativo)
# Alternativa:  deepseek/deepseek-v4-flash  (mais barato, mas pode alucinar nome/state)
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it

# Modelo barato pra desempate de matching (food name -> TACO entry).
# Opcional — tem default sensato no código.
OPENROUTER_RERANK_MODEL=google/gemma-2-9b-it:free

# === Postgres (Supabase) ===
# Settings -> Database -> Connection string -> URI
# Modo "Transaction" (porta 6543) ou "Direct" (5432). Ambos funcionam.
DATABASE_URL=

# === WhatsApp via Twilio (opcional) ===
# Se TODAS as 5 vars abaixo estiverem preenchidas, o adapter WhatsApp sobe.
# Caso contrário, só o Telegram roda.
#
# Twilio Console -> Account Info:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
#
# Sandbox de teste (grátis):       whatsapp:+14155238886
# Número de produção (aprovado):   whatsapp:+55SEUNUMERO
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
#
# Telefone(s) autorizado(s) em formato E.164. Lista separada por vírgula.
# Vazio = qualquer número pode falar com o bot (cada um vira um user_id
# próprio, derivado dos dígitos do telefone).
# Se ALLOWED_USER_ID estiver setado, todos os telefones da lista compartilham
# esse user_id (útil pra single-user multi-device).
#   WHATSAPP_LINK_PHONE=                            # qualquer um
#   WHATSAPP_LINK_PHONE=+5521985857972              # só este número
#   WHATSAPP_LINK_PHONE=+5521985857972,+5511987...  # vários
WHATSAPP_LINK_PHONE=
#
# URL pública do seu servidor (Cloudflare Tunnel / ngrok / VPS).
# Twilio precisa alcançar /twilio/webhook nesse host.
PUBLIC_BASE_URL=https://seu-tunel.trycloudflare.com
#
# Porta/host do webhook (default 0.0.0.0:8000)
WHATSAPP_WEBHOOK_HOST=0.0.0.0
WHATSAPP_WEBHOOK_PORT=8000
#
# Validação da assinatura X-Twilio-Signature. Mantenha "1" em produção.
# Use "0" só pra debug local quando não tiver túnel rodando.
TWILIO_VALIDATE=1
